{
  "name": "floatingpoint/stylist",
  "description": "Laravel 10 theming package.",
  "license": "MIT",
  "authors": [
    {
      "name": "Kirk Bushell",
      "email": "torm3nt@gmail.com"
    },
    {
      "name": "Mike Dugan",
      "email": "mike@mjdugan.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/console": "^10.0",
    "illuminate/container": "^10.0",
    "illuminate/routing": "^10.0",
    "illuminate/support": "^10.0",
    "illuminate/view": "^10.0",
    "spatie/laravel-html": "^3.5"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0",
    "larastan/larastan": "^2.11",
    "laravel/pint": "^1.30"
  },
  "autoload": {
    "psr-4": {
      "FloatingPoint\\Stylist\\": "src/Stylist",
      "Tests\\": "tests"
    }
  },
  "prefer-stable": true,
  "config": {
    "preferred-install": "dist"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse src tests",
    "format": "pint",
    "format:test": "pint --test",
    "check": [
      "@format:test",
      "@analyse",
      "@test"
    ]
  }
}
