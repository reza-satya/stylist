{
  "name": "floatingpoint/stylist",
  "description": "Laravel 5 theming package.",
  "authors": [
    {
      "name": "Kirk Bushell",
      "email": "torm3nt@gmail.com"
    },
    {
      "name": "Mike Dugan",
      "email": "mike@mjdugan.com"
    }
  ],
  "require": {
    "php": "^7.2",
    "illuminate/support": "^6.0|^7.0",
    "laravel/framework": "^6.0|^7.0",
    "spatie/laravel-html": "^2.30"
  },
  "require-dev": {
    "orchestra/testbench": "^4.0|^5.0"
  },
  "autoload": {
    "psr-4": {
      "RezaSatya\\Stylist\\": "src/Stylist",
      "Tests\\": "tests"
    }
  },
  "minimum-stability": "dev",
  "config": {
    "preferred-install": "dist"
  },
  "extra": {
    "laravel": {
      "providers": [
        "RezaSatya\\Stylist\\StylistServiceProvider"
      ]
    }
  }
}
